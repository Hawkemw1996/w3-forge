[Unit]
Description=W3 Forge application and admin console
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Owner-approved reference privilege model: authenticated Forge admins can open
# a root terminal and run confirmed host operations. No unrestricted sudo grant.
# Stage and build /opt/w3forge before installing; see docs/SERVICE_STANDARD_v0.4.2.md.
User=root
Group=root
WorkingDirectory=/opt/w3forge
Environment=W3_FORGE_ROOT=/opt/w3forge
Environment=W3_FORGE_ACTIVE_APP=w3forge
Environment=NODE_ENV=production
Environment=ADMIN_TERMINAL_ENABLED=true
# Required, root-owned 0600 file, read by systemd.
EnvironmentFile=/etc/w3forge/admin.env
ExecStart=/usr/bin/bash /opt/w3forge/scripts/w3-admin-console.sh --app w3forge --foreground
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
