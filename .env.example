# W3 Forge v0.4.1 — example only. Export these through the existing launcher/service environment.
# The backend does not automatically read a .env file. Never commit real secrets.
CORE_API_URL=http://127.0.0.1:3000
CORE_PUBLIC_URL=https://core.example.internal
FORGE_PUBLIC_URL=https://forge.example.internal
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CORE_APP_CLIENT_SECRET=__unique_43_character_pairing_credential__
# Generate once: node -e "console.log(require('crypto').randomUUID())"
CORE_APP_INSTANCE_ID=__stable_instance_uuid__
COOKIE_SECURE=true
# Existing W3_FORGE_ROOT, W3_FORGE_ACTIVE_APP and network settings still apply.

# Optional manual material pricing service. Disabled until explicitly configured.
# Separate credentials; never reuse CORE_APP_CLIENT_SECRET. Generate a new 32-byte hex token.
W3_FORGE_MATERIAL_PRICING_ENABLED=false
W3_FORGE_MATERIAL_PRICING_SHARED_TOKEN=
W3_FORGE_MATERIAL_PRICING_APIFY_TOKEN=
# Required absolute durable service-owned directory OUTSIDE this checkout when enabled.
W3_FORGE_MATERIAL_PRICING_DATA_DIR=
W3_FORGE_MATERIAL_PRICING_MAX_PRODUCTS=10
W3_FORGE_MATERIAL_PRICING_MAX_REQUEST_CHARGE_CENTS=10
W3_FORGE_MATERIAL_PRICING_MAX_DAILY_CHARGE_CENTS=100
W3_FORGE_MATERIAL_PRICING_MAX_LEDGER_ENTRIES=1000
W3_FORGE_MATERIAL_PRICING_REQUEST_TIMEOUT_MS=25000
W3_FORGE_MATERIAL_PRICING_ACTOR_TIMEOUT_SECONDS=180
W3_FORGE_MATERIAL_PRICING_OLLAMA_URL=http://127.0.0.1:11434
# Set the exact INSTALLED qwen2.5:tag or qwen2.5-coder:tag; blank leaves matching unavailable, collection can still run.
W3_FORGE_MATERIAL_PRICING_OLLAMA_MODEL=
# See docs/MATERIAL_PRICING.md for request contracts, bounds and recovery.

# Interactive Linux admin terminal (off until the operator enables it).
ADMIN_TERMINAL_ENABLED=false
# Optional credential-free browser link to an existing n8n instance; no API access implied.
W3_FORGE_N8N_URL=
# Host inventory currently includes qwen2.5-coder:14b; select it explicitly above if desired.
# Optional systemd template: config/systemd/w3forge-admin.service
# Activation and rollback: docs/APP_FOUNDATION_v0.4.1.md
